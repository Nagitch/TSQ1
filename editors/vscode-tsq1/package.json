{
  "name": "tsq1-editor",
  "displayName": "TSQ1 Sequence Editor",
  "description": "Inspect and edit TSQ1 binary sequence files.",
  "version": "0.1.0",
  "publisher": "nagitch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nagitch/TSQ1.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "tsq1",
    "midi",
    "osc",
    "timeline"
  ],
  "activationEvents": [
    "onCustomEditor:tsq1.sequenceEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "tsq1.sequenceEditor",
        "displayName": "TSQ1 Sequence Editor",
        "selector": [
          {
            "filenamePattern": "*.tsq"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "tsx --test src/codec.test.ts",
    "package": "npm run check && npm run lint && npm run test && npm run build",
    "vsix": "npm run package && vsce package --out dist/tsq1-editor.vsix"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "files": [
    "dist/extension.js",
    "README.md",
    "LICENSE"
  ]
}
